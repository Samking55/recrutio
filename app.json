{
  "expo": {
    "name": "recrutio",
    "slug": "recrutio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/recrutio-logo03.jpg",
    "scheme": "recrutio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.recrutio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d9482",
        "foregroundImage": "./assets/images/recrutio-logo03.jpg",
        "backgroundImage": "./assets/images/recrutio-logo03.jpg",
        "monochromeImage": "./assets/images/recrutio-logo03.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.recrutio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/recrutio-logo03.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/recrutio-logo03.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d9482",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
